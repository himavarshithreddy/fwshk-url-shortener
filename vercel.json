{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "back.brnk.in" }],
      "destination": "/backend/server.js"
    },
    { "source": "/health", "destination": "/backend/server.js" },
    { "source": "/shorten", "destination": "/backend/server.js" },
    { "source": "/track/:id", "destination": "/backend/server.js" },
    { "source": "/verify-password/:id", "destination": "/backend/server.js" },
    { "source": "/link-info/:id", "destination": "/backend/server.js" },
    { "source": "/:code([a-zA-Z0-9_-]{5,})", "destination": "/backend/server.js" },
    { "source": "/:path*", "destination": "/frontend/:path*" }
  ]
}
  
