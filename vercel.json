{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "back.brnk.in" }],
      "dest": "/backend/server.js"
    },
    { "src": "/health", "dest": "/backend/server.js" },
    { "src": "/shorten", "dest": "/backend/server.js" },
    { "src": "/track/([^/]+)", "dest": "/backend/server.js" },
    { "src": "/verify-password/([^/]+)", "dest": "/backend/server.js" },
    { "src": "/link-info/([^/]+)", "dest": "/backend/server.js" },
    { "src": "/([a-zA-Z0-9_-]{5,})", "dest": "/backend/server.js" },
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ]
}
  
